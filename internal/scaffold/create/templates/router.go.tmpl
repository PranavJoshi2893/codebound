package router

import (
	"net/http"

	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
)

func Routes() http.Handler {

	r := chi.NewRouter()
	r.Use(middleware.RequestID)
	r.Use(middleware.Logger)
	r.Use(middleware.Recoverer)

	// Cross-origin access is disabled by default. If needed, add CORS middleware
	// with an explicit allowlist of trusted frontend origins, not wildcard hosts.

	return r
}
